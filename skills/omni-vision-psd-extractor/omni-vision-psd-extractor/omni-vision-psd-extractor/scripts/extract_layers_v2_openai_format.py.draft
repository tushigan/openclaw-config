#!/usr/bin/env python3
"""
修复版 API 调用 - 使用 OpenAI 兼容的图像编辑接口

正确的接口格式：
- gpt-image-2-pro: POST {base_url}/v1/images/edits
- gemini-3.1-flash-image-preview: POST {base_url}/v1/images/edits

请求格式（multipart/form-data）：
- image: 原始图片文件（binary）
- prompt: 提示词（text）
- model: 模型名称（text）
- n: 生成数量（默认1）
- size: 输出尺寸（如 "1024x1024"）

响应格式：
{
  "data": [
    {
      "url": "https://...",  // 或
      "b64_json": "base64..."
    }
  ]
}
"""

import base64
import json
import mimetypes
import urllib.request
import urllib.parse
from pathlib import Path


def build_multipart_form_data(fields, files):
    """
    构建 multipart/form-data 请求体

    fields: dict of {name: value}
    files: dict of {name: (filename, content_bytes, content_type)}
    """
    boundary = "----WebKitFormBoundary" + base64.b64encode(os.urandom(16)).decode('ascii')

    parts = []

    # 添加文本字段
    for name, value in fields.items():
        parts.append(f'--{boundary}'.encode())
        parts.append(f'Content-Disposition: form-data; name="{name}"'.encode())
        parts.append(b'')
        parts.append(str(value).encode('utf-8'))

    # 添加文件字段
    for name, (filename, content, content_type) in files.items():
        parts.append(f'--{boundary}'.encode())
        parts.append(f'Content-Disposition: form-data; name="{name}"; filename="{filename}"'.encode())
        parts.append(f'Content-Type: {content_type}'.encode())
        parts.append(b'')
        parts.append(content)

    parts.append(f'--{boundary}--'.encode())
    parts.append(b'')

    body = b'\r\n'.join(parts)
    content_type = f'multipart/form-data; boundary={boundary}'

    return body, content_type


def call_openai_image_edit_api(
    api_key: str,
    base_url: str,
    model: str,
    image_path: Path,
    prompt: str,
    timeout: int = 600
) -> dict:
    """
    调用 OpenAI 兼容的图像编辑 API

    返回格式：
    {
        "status": "success" | "error",
        "image_b64": "base64..." (if success),
        "url": "https://..." (if success),
        "error": "..." (if error)
    }
    """

    endpoint = f"{base_url.rstrip('/')}/v1/images/edits"

    # 读取图片
    image_bytes = image_path.read_bytes()
    mime_type = mimetypes.guess_type(str(image_path))[0] or "image/png"

    # 构建请求
    fields = {
        "model": model,
        "prompt": prompt,
        "n": 1,
        "response_format": "b64_json"  # 返回 base64 编码
    }

    files = {
        "image": (image_path.name, image_bytes, mime_type)
    }

    body, content_type = build_multipart_form_data(fields, files)

    headers = {
        "Authorization": f"Bearer {api_key}",
        "Content-Type": content_type
    }

    request = urllib.request.Request(
        endpoint,
        data=body,
        headers=headers,
        method="POST"
    )

    try:
        with urllib.request.urlopen(request, timeout=timeout) as response:
            response_text = response.read().decode('utf-8')
            data = json.loads(response_text)

            # 提取图片数据
            if "data" in data and len(data["data"]) > 0:
                item = data["data"][0]

                if "b64_json" in item:
                    return {
                        "status": "success",
                        "image_b64": item["b64_json"]
                    }
                elif "url" in item:
                    return {
                        "status": "success",
                        "url": item["url"]
                    }

            return {
                "status": "error",
                "error": "Response does not contain image data"
            }

    except urllib.error.HTTPError as e:
        error_body = e.read().decode('utf-8', errors='replace')
        return {
            "status": "error",
            "error": f"HTTP {e.code}: {error_body[:500]}"
        }
    except Exception as e:
        return {
            "status": "error",
            "error": str(e)
        }


# 使用示例：
"""
result = call_openai_image_edit_api(
    api_key="sk-xxx",
    base_url="https://s.lconai.com",
    model="gpt-image-2-pro",
    image_path=Path("source.png"),
    prompt="提取背景，保持其他不变",
    timeout=600
)

if result["status"] == "success":
    image_data = base64.b64decode(result["image_b64"])
    Path("output.png").write_bytes(image_data)
"""
