# 主 workspace：独立 git 仓库，由自身管理
# 人格文件（AGENTS.md, IDENTITY.md, SOUL.md, USER.md 等）已在其自己的 git 中跟踪
# 部署时需要单独处理此目录
workspace/

# 子 workspace：只跟踪 AGENTS.md 和人格文件
workspace-design/*
!workspace-design/AGENTS.md
!workspace-design/SOUL.md
!workspace-design/IDENTITY.md
!workspace-design/USER.md
!workspace-design/skills/
workspace-design/skills/*
!workspace-design/skills/product-photography-workflow/
!workspace-design/skills/product-photography-workflow/**
!workspace-design/skills/gpt-image2-gen/
!workspace-design/skills/gpt-image2-gen/**

workspace-video/*
!workspace-video/AGENTS.md
!workspace-video/SOUL.md
!workspace-video/IDENTITY.md
!workspace-video/USER.md

workspace-research/*
!workspace-research/AGENTS.md
!workspace-research/SOUL.md
!workspace-research/IDENTITY.md
!workspace-research/USER.md
!workspace-research/skills/
workspace-research/skills/*
!workspace-research/skills/internal-interview-research/
!workspace-research/skills/internal-interview-research/**

workspace-strategy/*
!workspace-strategy/AGENTS.md
!workspace-strategy/SOUL.md
!workspace-strategy/IDENTITY.md
!workspace-strategy/USER.md

workspace-meeting/*
!workspace-meeting/AGENTS.md
!workspace-meeting/SOUL.md
!workspace-meeting/IDENTITY.md
!workspace-meeting/USER.md

workspace-copywriter/*
!workspace-copywriter/AGENTS.md
!workspace-copywriter/SOUL.md
!workspace-copywriter/IDENTITY.md
!workspace-copywriter/USER.md

workspace-business/*
!workspace-business/AGENTS.md
!workspace-business/SOUL.md
!workspace-business/IDENTITY.md
!workspace-business/USER.md

workspace-ppt/

media/
logs/
browser/
extensions/
venv-psd/
skills-store*/
openclaw-web/
memos-local/
delivery-queue/
canvas/
completions/
devices/
qqbot/
test/

# credentials：只跟踪 admin 用户列表（不跟踪密钥）
credentials/*
!credentials/feishu-admin-users.json

# 不跟踪敏感文件
.env
*.secrets.json

# Agent 敏感配置（改用脱敏模板）
agents/*/agent/models.json
agents/*/agent/auth-profiles.json
# 允许跟踪脱敏模板
!agents/*/agent/models.json.template
!agents/*/agent/auth-profiles.json.template

# 不跟踪运行时数据
flows/
identity/
feishu/
agents/*/sessions/
memory/*.sqlite
memory/*.sqlite-shm
memory/*.sqlite-wal
tasks/

# 跟踪 subagents 注册表
# subagents/ 保留忽略（runs.json 可重新生成）
subagents/

# 跟踪 cron 运行记录目录结构但忽略运行数据
cron/runs/

# skills 中的大文件和缓存
skills/**/output/
skills/**/__pycache__/
skills/**/*.mp4
skills/**/*.pyc
skills/tvc-director

# 备份和临时文件
*.bak
*.bak-*
*.backup*
*.broken
*.clobbered*
*.truncated*
.gpt_image_failover_state.json
update-check.json
update-check.json.*.tmp
viewer-auth.json
openclaw.json.bak.*

# 系统文件
.DS_Store
.claude/
.vscode/
